#!/bin/sh
# Debian package: "remove" keeps the data (/var/lib/tonearmix); "purge"
# also deletes the data, the service account and the inotify setting.
# Paquet Debian : « remove » garde les données (/var/lib/tonearmix) ;
# « purge » supprime aussi les données, le compte du service et le réglage
# inotify.
set -e

if [ -d /run/systemd/system ]; then
    systemctl daemon-reload || true
fi
if [ "$1" = "purge" ]; then
    rm -rf /var/lib/tonearmix
    rm -f /etc/sysctl.d/60-tonearmix-inotify.conf
    if getent passwd tonearmix >/dev/null; then
        deluser --system tonearmix >/dev/null 2>&1 || userdel tonearmix || true
    fi
    if getent group tonearmix >/dev/null; then
        delgroup --system tonearmix >/dev/null 2>&1 || groupdel tonearmix || true
    fi
fi
exit 0
