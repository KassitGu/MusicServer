#!/bin/sh
# Appelé par le Centre de paquets de DSM 7 (compte du paquet).
# Toute la logique est dans musique.sh, installé dans le dossier du paquet.
case "$1" in
    start|stop|status|restart)
        exec /bin/sh "${SYNOPKG_PKGDEST:-/var/packages/MusiqueServeur/target}/musique.sh" "$1"
        ;;
    log)
        echo "${SYNOPKG_PKGVAR:-/var/packages/MusiqueServeur/var}/etat/superviseur.log"
        ;;
esac
exit 0
