#!/bin/sh
# Called by the DSM 7 Package Center; the logic lives in musique.sh.
# Appelé par le Centre de paquets de DSM 7 ; la logique est dans musique.sh.
case "$1" in
    start|stop|status|restart)
        exec /bin/sh "${SYNOPKG_PKGDEST:-/var/packages/MusiqueServeur/target}/musique.sh" "$1"
        ;;
    log)
        echo "${SYNOPKG_PKGVAR:-/var/packages/MusiqueServeur/var}/state/supervisor.log"
        ;;
esac
exit 0
