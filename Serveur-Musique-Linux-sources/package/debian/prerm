#!/bin/sh
# Debian package: stops the service before removal or upgrade.
# Paquet Debian : arrête le service avant suppression ou mise à jour.
set -e

if [ -d /run/systemd/system ]; then
    systemctl stop musique-nas.service || true
    if [ "$1" = "remove" ]; then
        systemctl disable musique-nas.service >/dev/null 2>&1 || true
    fi
fi
exit 0
